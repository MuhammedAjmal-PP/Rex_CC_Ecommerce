# ─────────────────────────────────────────────────────────────────────────────
#  Rex CC Ecommerce — Local Development Environment
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Django Core ─────────────────────────────────────────────────────────────

# A long, random, secret string. Keep this secret in production.
# Generate one: python -c "from django.utils.crypto import get_random_string; print(get_random_string(50))"
SECRET_KEY=your-very-secret-key-here

# Set to True in development to see detailed error pages.
# NEVER set True in production.
DEBUG=True

# Comma-separated list of hostnames Django will respond to.
# Include tunnel URLs if using Cloudflare or ngrok.
ALLOWED_HOSTS=localhost,127.0.0.1

# django.contrib.sites framework ID (default: 1)
SITE_ID=1


# ─── Database ────────────────────────────────────────────────────────────────

# PostgreSQL connection URL.
# Format: postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# NOTE: When running via Docker, this is overridden by docker-compose.yml
#       to use 'db' as the host (the service name) instead of 'localhost'.
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/rexcc_db

# Individual DB credentials — used by docker-compose to create the PostgreSQL
# container and to build the DATABASE_URL override automatically.
DB_NAME=rexcc_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password


# ─── Cloudinary (Media Storage) ──────────────────────────────────────────────

# All user-uploaded media (product images, avatars, return photos) go here.
# Get it from: https://cloudinary.com/console -> API Keys
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name


# ─── Email (SMTP) ────────────────────────────────────────────────────────────

# For development you can use console backend (prints emails to terminal):
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email delivery via Gmail SMTP:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Gmail address used to send OTP and password-reset emails.
EMAIL_HOST_USER=your_email@gmail.com

# Use a Gmail App Password (not your regular password).
# Enable 2FA -> Google Account -> Security -> App Passwords
EMAIL_HOST_PASSWORD=your_gmail_app_password


# ─── Google OAuth ────────────────────────────────────────────────────────────

# Required for Sign in with Google.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_SECRET_KEY=your-google-client-secret


# ─── CSRF ────────────────────────────────────────────────────────────────────

# Comma-separated trusted origins for CSRF protection.
# Include tunnel URLs you use during development.
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1


# ─── Razorpay (Payments) ─────────────────────────────────────────────────────

# Use Razorpay TEST mode keys during development.
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret


# ─── Business Rules (Optional) ───────────────────────────────────────────────
# All settings below have sensible defaults and can be omitted.
# Uncomment and change only what you need to override.

# How many seconds before a FAILED Razorpay order is auto-expired.
# Default: 18000 (5 hours). Use 120 (2 min) for fast dev testing.
FAILED_ORDER_EXPIRY_SECONDS=120

# Maximum saved addresses per user account.
MAX_ADDRESSES_PER_USER=5

# Maximum units of a single variant per cart item.
MAX_QUANTITY_PURCHASE_PER_ITEM=5

# Flat shipping charge per item in the order (₹).
SHIPPING_CHARGE=100

# Wallet top-up range (₹). Users cannot top up outside this range.
WALLET_TOPUP_MIN=5000
WALLET_TOPUP_MAX=75000

# Wallet credit awarded to both referee and referrer on a successful referral (₹).
REFERRAL_REWARD_AMOUNT=1000

# Number of days after delivery within which a return request can be raised.
RETURN_WINDOW_DAYS=7

# Maximum image upload size in megabytes (applies to all image fields).
IMAGE_MAX_SIZE_MB=5

# GST rate applied to all orders (percentage).
GST_RATE=18

# Store location for GST invoicing.
# STORE_STATE_CODE: 32 = Kerala. See https://cleartax.in/s/gst-state-codes
STORE_STATE=KERALA
STORE_STATE_CODE=32

# HSN code for the primary product category.
# 9102 = Wristwatches (quartz or other battery-operated).
DEFAULT_WATCH_HSN=9102

# Default phone number region for validation.
# Uses ISO 3166-1 alpha-2 country codes (e.g. IN, US, GB).
PHONENUMBER_DEFAULT_REGION=IN
