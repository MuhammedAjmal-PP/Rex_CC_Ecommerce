# ─────────────────────────────────────────────────────────────────────────────
#  Rex CC Ecommerce — Docker Environment
#  Copy this file to .env.docker and fill in your values.
#  Used by: docker compose up (loaded via env_file in docker-compose.yml)
#  NEVER commit .env.docker to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Django Core ─────────────────────────────────────────────────────────────

# A long, random, secret string. Generate a fresh one for every environment.
# python -c "from django.utils.crypto import get_random_string; print(get_random_string(50))"
SECRET_KEY=your-very-secret-key-here

# Set to True for local Docker testing (disables HTTPS redirect).
# Set to False in production (enables HSTS, secure cookies, SSL redirect).
DEBUG=True

# Comma-separated list of allowed hostnames.
# Local Docker:  localhost,127.0.0.1
# Production:    yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# django.contrib.sites framework ID (default: 1, must match DB)
SITE_ID=1


# ─── Database ────────────────────────────────────────────────────────────────

# IMPORTANT: The host "db" is the name of the PostgreSQL container defined
# in docker-compose.yml. Docker's internal DNS resolves it automatically.
# Format: postgres://USERNAME:PASSWORD@CONTAINER_NAME:PORT/DATABASE_NAME
#
# These must match the POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# values in the "db" service inside docker-compose.yml.
DATABASE_URL=postgres://rexcc_user:your_secure_db_password@db:5432/rexcc_db


# ─── Cloudinary (Media Storage) ──────────────────────────────────────────────

# Same cloud account works for both local and Docker — Cloudinary is external.
# Get from: https://cloudinary.com/console → API Keys
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name


# ─── Email (SMTP) ────────────────────────────────────────────────────────────

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Gmail address used to send OTP and password-reset emails.
EMAIL_HOST_USER=your_email@gmail.com

# Use a Gmail App Password (not your regular password).
EMAIL_HOST_PASSWORD=your_gmail_app_password


# ─── Google OAuth ────────────────────────────────────────────────────────────

# Required for "Sign in with Google".
# Authorised redirect URI for Docker local: http://localhost/accounts/google/login/callback/
# Production URI: https://yourdomain.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_SECRET_KEY=your-google-client-secret


# ─── CSRF ────────────────────────────────────────────────────────────────────

# Local Docker: http://localhost,http://127.0.0.1
# Production:   https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1


# ─── Razorpay (Payments) ─────────────────────────────────────────────────────

# Use TEST mode keys for local Docker. Switch to LIVE keys in production.
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret


# ─── Business Rules (Optional) ───────────────────────────────────────────────

# How many seconds before a FAILED Razorpay order is auto-expired.
# Default: 18000 (5 hours). Use 120 (2 min) for fast local testing.
FAILED_ORDER_EXPIRY_SECONDS=120
